{
  "name": "octo-cli",
  "version": "0.0.1",
  "description": "CLI Octo - Automação de conversão de mídia e dados",
  "type": "module",
  "bin": {
    "octo": "./src/index.ts"
  },
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build ./src/index.ts --compile --outfile octo",
    "build:all": "bash scripts/build-all.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "@dsnp/parquetjs": "^1.8.7",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@types/marked": "^6.0.0",
    "boxen": "^8.0.1",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "csvtojson": "^2.0.14",
    "dotenv": "^17.3.1",
    "execa": "^9.0.0",
    "figlet": "^1.10.0",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.2.0",
    "js-yaml": "^4.1.1",
    "json2csv": "^6.0.0-alpha.2",
    "listr2": "^8.0.0",
    "marked": "^17.0.4",
    "p-queue": "^9.1.0",
    "sharp": "^0.33.2",
    "youtube-dl-exec": "^3.0.30",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/figlet": "^1.7.0",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/json2csv": "^5.0.7",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
